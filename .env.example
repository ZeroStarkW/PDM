SERVER_PORT=8080
PDM_DB_URL=jdbc:postgresql://localhost:5432/pdm
PDM_DB_USERNAME=pdm
PDM_DB_PASSWORD=replace-for-local-use
PDM_INFLUX_URL=http://localhost:8181
PDM_INFLUX_TOKEN=generated-by-scripts/Setup-Local.ps1
PDM_INFLUX_DATABASE=pdm-ts-data
PDM_INFLUX_RETENTION=365d
PDM_MQTT_ENABLED=true
PDM_MQTT_URL=tcp://localhost:1883
PDM_MQTT_CLIENT_ID=pdm-platform
# Broker 认证凭据；本地 Mosquitto 匿名访问，留空即匿名连接
PDM_MQTT_USERNAME=
PDM_MQTT_PASSWORD=
PDM_MQTT_TOPIC=pdm/v1/+/+/+/telemetry
PDM_MQTT_V2_TOPIC=pdm/v2/+/+/+/telemetry
PDM_ADMIN_USERNAME=admin
PDM_ADMIN_PASSWORD=change-this-before-start
PDM_COOKIE_SECURE=false
PDM_ALERT_WEBHOOK_ENABLED=false
PDM_ALERT_WEBHOOK_URL=
PDM_NOTIFICATION_POLL_INTERVAL=PT5S
PDM_NOTIFICATION_ACKNOWLEDGEMENT_SLA=PT30M
PDM_NOTIFICATION_INITIAL_BACKOFF=PT30S
PDM_NOTIFICATION_MAX_BACKOFF=PT1H
PDM_NOTIFICATION_MAX_ATTEMPTS=8
PDM_MAINTENANCE_POLL_INTERVAL=PT1M
# 演示数据：compose 与 application.yml 默认为 false，此处 true 仅为本地演示便利
PDM_DEMO_DATA=true
PDM_BASELINE_LEARNING_DURATION=PT6M
# 频谱基线参考带：滚动窗口样本冻结下限与窗口时长（1/6 倍频程谱域基线，文档 §4.2.1）
PDM_SPECTRUM_MIN_SAMPLES=30
PDM_SPECTRUM_WINDOW=P30D
# 遥测新鲜度：超过此时长未收到样本的测点在总览中标记为数据过期
PDM_TELEMETRY_STALE_AFTER=PT5M
# MCSA 告警阈值默认关闭：需离线比对与现场试点验收后开启
PDM_MCSA_ALERTS_ENABLED=false
# 以下均为候选设计值（含附件假设的 54/40 dB 边频带间距），须结合目标电机与现场标注数据校准
PDM_MCSA_LOAD_MIN_PCT=20
PDM_MCSA_LOAD_MAX_PCT=100
PDM_MCSA_SLIP_MAX_PCT=15
PDM_MCSA_SIDEBAND_WARN_DB=54
PDM_MCSA_SIDEBAND_DANGER_DB=40
PDM_MQTT_PHM_TOPIC=devices/+/+/telemetry
PDM_MQTT_PHM_RAW_TOPIC=devices/+/+/raw_waveform
# 协议 2.1.0 多模态遥测与突发快照主题（asset_id→设备编码、channel_id→测点编码）
PDM_MQTT_PHM21_TOPIC=phm/telemetry/+/+
PDM_MQTT_PHM_SNAPSHOT_TOPIC=phm/snapshot/+/+
# PHM 健康内核（文档 §4.3）：劣化动力学滑动窗口
PDM_HEALTH_DEGRADATION_WINDOW=PT24H
# 原始波形快照（文档 §2.2）：本地卷归档与解调带
PDM_WAVEFORM_STORAGE_DIR=./data/waveforms
PDM_WAVEFORM_BAND_LOW=1000
PDM_WAVEFORM_BAND_HIGH=2500
PDM_WAVEFORM_MAX_PREVIEW_POINTS=16384
# 高压断路器机械特性（协议 2.1.0 SWITCHGEAR_EVENT）：动作事件型模态，默认启用告警，可用开关关闭
# 以下倍率与时限均为默认设计值（同 MCSA），须结合现场断路器机械特性实测数据校准
PDM_SWITCHGEAR_ALERTS_ENABLED=true
PDM_SWITCHGEAR_DURATION_ATTENTION_RATIO=1.10
PDM_SWITCHGEAR_DURATION_DANGER_RATIO=1.20
PDM_SWITCHGEAR_CURRENT_ATTENTION_RATIO=0.80
PDM_SWITCHGEAR_STALE_AFTER=P30D
PDM_SWITCHGEAR_SAMPLE_RETENTION=P365D
PDM_SWITCHGEAR_DEGRADATION_WINDOW=P30D
# 断网补传的动作事件允许滞后上限（未来时间戳仍拒绝；其余模态保持 ±5 分钟）
PDM_SWITCHGEAR_MAX_PAST_DELAY=P30D
# 工艺调节阀（协议 2.1.0 CONTROL_VALVE_PROCESS）：连续低频过程量，仅 steady_state 样本评分与学习
# 死区倍率与超声泄漏阈值为默认设计值，须结合现场阀门回路实测数据校准
PDM_CONTROL_VALVE_ALERTS_ENABLED=true
PDM_CONTROL_VALVE_DEADBAND_ATTENTION_RATIO=2.5
PDM_CONTROL_VALVE_DEADBAND_DANGER_RATIO=5.0
PDM_CONTROL_VALVE_LEAK_ATTENTION_RMS=0.2
PDM_CONTROL_VALVE_LEAK_DANGER_RMS=0.5
PDM_CONTROL_VALVE_LEARNING_WINDOW=PT1H
